# Copy this file to .env.local and fill in the values to run the dashboard locally.
# Both values live in: Vercel → brainrot-dashboard → Settings → Environment Variables
# (or Supabase → Project Settings → API: "Project URL" and "anon public" key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only needed to trigger scrapes manually (/api/scrape?secret=...). Same value as on Vercel.
CRON_SECRET=
