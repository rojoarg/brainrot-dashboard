# Optional local config for Brainrot Market Intelligence.
# The app works with NO env vars — these only override defaults.

# Where the SQLite database lives. Defaults to ./data/brainrot.db in dev,
# and %APPDATA%/brainrot-dashboard/brainrot.db in the packaged desktop app.
# BRAINROT_DB_PATH=C:\path\to\brainrot.db

# Optional shared secret to protect the /api/scrape trigger (off by default;
# the local desktop app does not set it).
# CRON_SECRET=

# Optional shared secret to protect POST /api/config (off by default).
# CONFIG_SECRET=
