{
  "name": "brainrot-dashboard",
  "version": "1.2.2",
  "private": true,
  "description": "Brainrot Market Intelligence — local Eldorado.gg market analytics and auto-joiner config generator for Steal a Brainrot",
  "author": "Rojo Colo",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "electron": "electron .",
    "prepare:standalone": "node scripts/prepare-standalone.js",
    "dist:win": "next build && node scripts/prepare-standalone.js && electron-builder --win"
  },
  "build": {
    "appId": "com.rojocolo.brainrot-intel",
    "productName": "Brainrot Market Intelligence",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "license": "assets/eula.txt",
      "deleteAppDataOnUninstall": false,
      "artifactName": "BrainrotIntel-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
